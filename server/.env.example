# Copy to .env and adjust. .env is not committed.

# Where the SQLite database lives on the host. Must be writable by uid 10001.
SEV_DATA_DIR=/mnt/skpool/appdata/silverado-stats

# Dashboard: the LAN address only. Never 0.0.0.0, and never proxied by nginx.
SEV_DASH_BIND=10.0.0.15:8791

# Ingest: an address the nginx container can reach, not exposed by the router.
SEV_INGEST_BIND=10.0.0.15:8790

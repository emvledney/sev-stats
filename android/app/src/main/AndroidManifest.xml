<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Distributed on the REGULAR Play internal-testing track (the dedicated Android Automotive OS
      track stayed inactive for this account), so car features are declared but not required.
      The app checks FEATURE_AUTOMOTIVE / the car service at runtime. GM's Google built-in head
      units have the automotive feature.
    -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />

    <!-- Vehicle data: READ permissions only. No CONTROL_* / write permission is ever declared. -->
    <uses-permission android:name="android.car.permission.CAR_INFO" />
    <uses-permission android:name="android.car.permission.CAR_ENERGY" />
    <uses-permission android:name="android.car.permission.CAR_ENERGY_PORTS" />
    <uses-permission android:name="android.car.permission.CAR_EXTERIOR_ENVIRONMENT" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.READ_CAR_DISPLAY_UNITS" />

    <!-- Map tab: the truck's position on the map. Read by the app only; never sent anywhere but as the centre of a charger or place search. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Send to laptop report upload, network diagnostics; Map tab web lookups. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!--
      Battery log: the hourly job is persisted, so it survives a reboot of the head unit. The background
      service below starts at boot as well.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The background service below: nothing but the right to run one, no vehicle access of any kind. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
      Bluetooth: Classic discovery and pairing with the OBDLink MX+, then one RFCOMM serial
      connection to it (bt/ package only).
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
      Google's Navigation SDK (the Map tab's bundled map view) declares these for turn-by-turn
      guidance, background location and its own Bluetooth audio. The app only shows the map, so
      each one is stripped from the APK. SourceSafetyTest pins this list and checks the result.
      (FOREGROUND_SERVICE and RECEIVE_BOOT_COMPLETED, which the library also declares, are the app's
      own for its background service and are declared above, so they are not stripped.)
    -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" tools:node="remove" />
    <uses-permission-sdk-23 android:name="android.permission.BLUETOOTH" tools:node="remove" />
    <uses-permission-sdk-23 android:name="android.permission.BLUETOOTH_ADMIN" tools:node="remove" />
    <uses-permission android:name="android.permission.VIBRATE" tools:node="remove" />
    <uses-permission android:name="android.permission.WAKE_LOCK" tools:node="remove" />
    <uses-permission android:name="com.google.android.providers.gsf.permission.READ_GSERVICES" tools:node="remove" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SilveradoStats">

        <uses-library android:name="android.car" android:required="false" />

        <!-- Map tab: key for the bundled Google map (Navigation SDK), from local.properties. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!--
          OBD link (MX+ or demo simulator). Bound only by this app's own screens, never started,
          not exported: no other app can reach it, and it runs only while a screen is bound.
        -->
        <service
            android:name=".link.LinkService"
            android:exported="false" />

        <!--
          The battery log's hourly job (log/LogScheduler.kt). Only the system's JobScheduler may run it. It
          reads the built-in data once and, only with the truck reporting ignition on and an MX+ chosen,
          takes one row through the LinkService above.
        -->
        <service
            android:name=".log.LogJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!--
          Keeps the session of the truck's built-in data running with no screen up, the owner's choice
          (vehicle/VehicleWatchService.kt). Read-only, the truck's API only: it never touches the OBD link
          or the LinkService above, and holds no wake lock. Started by this app only, never exported.
          Special use: none of Android's other types is what it does.
        -->
        <service
            android:name=".vehicle.VehicleWatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Reads the truck's battery level and speed, read-only, to measure drives and charges with no screen open" />
        </service>

        <!-- Brings that service back after a reboot of the head unit or an update of the app. Only the system can send these. -->
        <receiver
            android:name=".vehicle.VehicleWatchStarter"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
          Simple, Live and Diagnostics. Marked distractionOptimized so that Android Automotive does
          not cover it when the truck leaves Park, which made the app nearly useless. A deliberate,
          accepted trade-off for this one owner's truck:
           - INTERNAL TESTING ONLY. It goes against Google's guidelines for car apps (a Compose screen
             is not a reviewed template), so this build must never go to a production Play track;
           - Android honours the flag only for apps installed from an allowed source (Play);
           - GM could block it in an update, and the app has no other screen for driving: the owner
             removed the templated fallback, Battery Glance, on 2026-11-07;
           - known limit: a system permission dialog opened in Park stays up if the truck then leaves
             Park. Android gives the app no way to close it, and the emulator's OS did not cover it
             (the truck's permission controller is untested). The app opens no further dialog.
          Out of Park the activity locks itself down (vehicle/DrivingState, ui/layout/DashLayout):
          Simple and Live with larger figures and no explanations, no Diagnostics, pairing, forms,
          dialogs, toggles or chart details, and values change at most once a second.
          The Map tab is the owner's deliberate exception (2026-11-10): charger search with the app's
          own keyboard, the filter pickers and the hand-off to Google Maps stay usable out of Park.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
    </application>

</manifest>
